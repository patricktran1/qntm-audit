# All optional. With none of these set the app runs fully; the API routes
# accept requests and drop them rather than failing.

# Send client analytics events to /api/events.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Where /api/events forwards. Leave unset to drop events.
# ANALYTICS_WEBHOOK_URL=

# Where /api/lead forwards. Leave unset to accept and log without contact
# details. Both sinks are optional and independent.
# LEAD_WEBHOOK_URL=
# LEAD_SLACK_WEBHOOK_URL=

# Gates /internal/* (sales brief, session events). UNSET IN PRODUCTION MEANS
# THOSE ROUTES RETURN 404 — the gate fails closed on purpose.
# INTERNAL_ACCESS_TOKEN=

# Origin used to build absolute links in lead notifications.
# NEXT_PUBLIC_SITE_URL=https://qntm-practice-audit.vercel.app

# Pilot persistence (Upstash Redis REST). UNSET MEANS NOTHING IS RETAINED — the
# product works fully, /internal/pilot stays empty, and outcome capture is
# disabled with a message saying why. No SDK or schema is required.
# PILOT_KV_REST_URL=https://your-db.upstash.io
# PILOT_KV_REST_TOKEN=
